// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "Rust",
	// Trixie with Rust 1.98.1 and upstream's build packages (see Dockerfile), to match
	// upstream's build image and CI toolchain. The earlier 1-1-bullseye image is past Debian 11 LTS.
	"build": { "dockerfile": "Dockerfile" },
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": true,
			"azureDnsAutoDetection": true,
			"installDockerBuildx": true,
			"installDockerComposeSwitch": true,
			"version": "latest",
			"dockerDashComposeVersion": "v2"
		},
		"ghcr.io/devcontainers-extra/features/kind:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/kubectl-asdf:2": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/python:1": {
			"installTools": true,
			"version": "latest"
		}
	},

	// Every crate in Cargo.lock, so later builds and tests need no network. The named cargo
	// volume is gone: it masked /usr/local/cargo and kept stale toolchains across image updates.
	"postCreateCommand": "cargo fetch --locked"

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
